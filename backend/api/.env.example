# =============================================================================
# Hissabi API — environment configuration
#
# Copy this file to `.env` and fill in the values you need. Production
# deployments should set these via the host's secrets/env config (Railway,
# Vercel, Fly, AWS Parameter Store, etc.) — DO NOT commit a real `.env`.
# =============================================================================

# Environment: development | staging | production
ENVIRONMENT=development

# -- Database ------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:secret@localhost:5432/hissabi
# Optional read replica
READ_DATABASE_URL=
TEST_DATABASE_URL=postgresql+asyncpg://postgres:secret@localhost:5432/hissabi_test

POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret
POSTGRES_DB=hissabi
TEST_POSTGRES_DB=hissabi_test

# -- Redis (optional — empty = use local in-memory cache fallback) -------------
REDIS_URL=redis://localhost:6379/0

# -- Authentication ------------------------------------------------------------
# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
JWT_ISSUER=hissabi
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# -- Storage -------------------------------------------------------------------
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./data/uploads
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Antivirus (optional)
CLAMAV_HOST=
CLAMAV_PORT=3310

# -- Uploads & documents -------------------------------------------------------
UPLOAD_MAX_MB=25
ALLOWED_MIME_TYPES=application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel,text/csv,application/pdf

# -- Frontend / CORS -----------------------------------------------------------
# Comma-separated. In production, set to your real frontend URL(s).
CORS_ORIGINS=http://localhost:3000
# Used for Stripe Checkout success/cancel redirects, etc.
FRONTEND_URL=http://localhost:3000

# -- Rate limits ---------------------------------------------------------------
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_UPLOADS_PER_MIN=3
REQUEST_TIMEOUT_SECONDS=30

# -- Database pooling ----------------------------------------------------------
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30
DB_STATEMENT_TIMEOUT_MS=60000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_TX_TIMEOUT_MS=30000
SQLALCHEMY_ECHO=false

# -- Feature flags -------------------------------------------------------------
FEATURE_INVENTORY_ENABLED=false
FEATURE_RECIPES_ENABLED=false

# -- Integrations: OpenAI ------------------------------------------------------
OPENAI_API_KEY=

# -- Integrations: Stripe ------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_PRO=

# -- Integrations: Twilio / WhatsApp -------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Format: whatsapp:+1XXXXXXXXXX
TWILIO_WHATSAPP_NUMBER=
WHATSAPP_RATE_LIMIT_PER_MIN=10

# -- Observability -------------------------------------------------------------
# Empty = Sentry disabled. Set DSN to enable error reporting.
SENTRY_DSN=
