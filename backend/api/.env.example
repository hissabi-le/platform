# API configuration
DATABASE_URL=postgresql+asyncpg://postgres:secret@localhost:5432/hissabi
READ_DATABASE_URL=
REDIS_URL=redis://localhost:6379/0

# Authentication
JWT_SECRET=change-me
JWT_ISSUER=hissabi
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Storage
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./data/uploads
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CLAMAV_HOST=
CLAMAV_PORT=3310

# Uploads & documents
UPLOAD_MAX_MB=25
ALLOWED_MIME_TYPES=application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel,text/csv,application/pdf

# Integrations
OPENAI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Frontend / CORS
CORS_ORIGINS=http://localhost:3000

# Rate limits
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_UPLOADS_PER_MIN=3
