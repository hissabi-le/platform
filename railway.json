{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "backend/api/Dockerfile"
    },
    "deploy": {
        "startCommand": "gunicorn src.main:app --workers 1 --worker-class uvicorn.workers.UvicornWorker --bind 0.0.0.0:8000",
        "healthcheckPath": "/health",
        "restartPolicyType": "ON_FAILURE"
    }
}